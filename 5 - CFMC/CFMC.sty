\tikzstyle{wires}=[thick,x=12pt,y=11pt]

\tikzstyle{TRleft}  = [isosceles triangle, isosceles triangle apex angle=60, shape border rotate=180]
\tikzstyle{TRright} = [isosceles triangle, isosceles triangle apex angle=60] 
