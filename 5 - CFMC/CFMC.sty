\makeatletter

\newcounter{@wire}
\newcounter{@wire@start}
\newcounter{@wire@end}
\newcounter{@wire@y}

\newcommand\leftlabel[1]{\node[anchor=east] at (\the@wire,\the@wire@y) {$#1$};}
\newcommand\rightlabel[1]{\node[anchor=west] at (\the@wire@end,\the@wire@y) {$#1$};}

\newcommand\wire[1]{
 \ifx#1.\let\wire@choice\@nowire\else%
 \ifx#1-\let\wire@choice\@wire\else%
 \ifx#1=\let\wire@choice\@wires\else%
 \fi\fi\fi%
 \wire@choice%
}

\newcommand\@nowire[3][0]{
    \setcounter{@wire}{#1}%
    \setcounter{@wire@y}{#2}%
	\wire@start#3\@end%
}

% Single wire

\newcommandx\@wire[5][1=0,3=\relax,5=\relax]{%
    \setcounter{@wire}{#1}%
    \setcounter{@wire@start}{#1}%
    \setcounter{@wire@end}{#1}%
    \setcounter{@wire@y}{#2}%
    \wire@line@start#4\@end%
    \ifx#3\relax\else\leftlabel{#3}\fi%
    \ifx#5\relax\else\rightlabel{#5}\fi%
	\wire@start#4\@end%
}
\newcommand\wire@next[1]{%
  \ifx#1\@end\let\wire@loop\relax\else%
  \ifx#1.\stepcounter{@wire}\else%
  \ifx#1/\stepcounter{@wire}\else%
  \ifx#1|\wire@bar\else%
  \ifx#1>\let\wire@loop\wire@push\else%
  \ifx#1<\let\wire@loop\wire@pop\else%
  \ifx#1+\let\wire@loop\wire@send\else%
  \ifx#1^\let\wire@loop\wire@sup\else%
  \ifx#1_\let\wire@loop\wire@sub\else%
  \fi\fi\fi\fi\fi\fi\fi\fi\fi%
  \wire@loop%
}
\newcommand\wire@start{\let\wire@loop\wire@next\wire@loop}
\newcommand\wire@gobble[1]{\let\wire@loop\wire@next\wire@loop}
\newcommand\wire@line@start{\let\wire@line@loop\wire@line@next\wire@line@loop}
\newcommand\wire@line@next[1]{%
  \ifx#1\@end%
    \draw(\the@wire@start,\the@wire@y) -- (\the@wire@end,\the@wire@y);%
    \let\wire@line@loop\relax%
  \else%
  \ifx#1/\stepcounter{@wire@end}\stepcounter{@wire@start}\else%
  \ifx#1.\stepcounter{@wire@end}\else%
  \fi\fi\fi%
  \wire@line@loop%
}
\newcommand\wire@bar{
  \coordinate[yshift= 2pt] (a) at (\the@wire,\the@wire@y);
  \coordinate[yshift=-2pt] (b) at (\the@wire,\the@wire@y);
  \draw (a)--(b);}
\newcommand\wire@push{\@ifnextchar>\wire@push@two\wire@push@one}
\newcommand\wire@pop {\@ifnextchar<\wire@pop@two{\@ifnextchar+\wire@popsend\wire@pop@one}}
\newcommand\wire@send{\@ifnextchar+\wire@send@two{\@ifnextchar<\wire@sendpop\wire@send@one}}
\newcommand\wire@push@one{\node[push] at (\the@wire,\the@wire@y) {};\wire@start}
\newcommand\wire@pop@one {\node[pop1] at (\the@wire,\the@wire@y) {};\wire@start}
\newcommand\wire@send@one{\node[send] at (\the@wire,\the@wire@y) {};\wire@start}
\newcommand\wire@push@two{
    \node[push,xshift= 2pt] at (\the@wire,\the@wire@y) {};
    \node[push,xshift=-2pt] at (\the@wire,\the@wire@y) {};
    \wire@gobble}
\newcommand\wire@pop@two {
	\node[pop1,xshift= 2pt] at (\the@wire,\the@wire@y) {};
	\node[pop1,xshift=-2pt] at (\the@wire,\the@wire@y) {}; 
	\node[pop2,xshift= 2pt] at (\the@wire,\the@wire@y) {};
	\wire@gobble}
\newcommand\wire@send@two{
    \node[send,xshift= 2pt] at (\the@wire,\the@wire@y) {};
    \node[send,xshift=-2pt] at (\the@wire,\the@wire@y) {};
    \wire@gobble}
\newcommand\wire@sendpop{
    \node[send,xshift=-2pt] at (\the@wire,\the@wire@y) {};
    \node[pop1,xshift= 2pt] at (\the@wire,\the@wire@y) {};
    \wire@gobble}
\newcommand\wire@popsend{
    \node[send,xshift= 2pt] at (\the@wire,\the@wire@y) {};
    \node[pop1,xshift=-2pt] at (\the@wire,\the@wire@y) {};
    \wire@gobble}
\newcommand\wire@sup[1]{\node[yshift=  8pt,anchor=base] at (\the@wire,\the@wire@y) {$\wire@label{#1}$};\wire@start}
\newcommand\wire@sub[1]{\node[yshift=-15pt,anchor=base] at (\the@wire,\the@wire@y) {$\wire@label{#1}$};\wire@start}

% Double wires

\newdimen\yup\yup=2.28pt
\newdimen\ydn\ydn-2.28pt

\newcommandx\@wires[5][1=0,3=\relax,5=\relax]{%
    \setcounter{@wire}{#1}%
    \setcounter{@wire@start}{#1}%
    \setcounter{@wire@end}{#1}%
    \setcounter{@wire@y}{#2}%
    \wires@line@start#4\@end%
    \ifx#3\relax\else\leftlabel{#3}\fi%
    \ifx#5\relax\else\rightlabel{#5}\fi%
	\wires@start#4\@end%
}
\newcommand\wires@next[1]{%
  \ifx#1\@end\let\wires@loop\relax\else%
  \ifx#1.\stepcounter{@wire}\else%
  \ifx#1>\let\wires@loop\wires@push\else%
  \ifx#1<\let\wires@loop\wires@pop\else%
  \ifx#1+\let\wires@loop\wires@send\else%
  \ifx#1^\let\wires@loop\wires@sup\else%
  \ifx#1_\let\wires@loop\wires@sub\else%
  \fi\fi\fi\fi\fi\fi\fi%
  \wires@loop%
}
\newcommand\wires@start{\let\wires@loop\wires@next\wires@loop}
\newcommand\wires@gobble[1]{\let\wires@loop\wires@next\wires@loop}
\newcommand\wires@line@start{\let\wires@line@loop\wires@line@next\wires@line@loop}
\newcommand\wires@line@next[1]{%
  \ifx#1\@end%
    \begin{scope}[yshift=\yup]%
    \draw(\the@wire@start,\the@wire@y) -- (\the@wire@end,\the@wire@y);%
    \end{scope}%
    \begin{scope}[yshift=\ydn]%
    \draw(\the@wire@start,\the@wire@y) -- (\the@wire@end,\the@wire@y);%
    \end{scope}%
    \let\wires@line@loop\relax%
  \else%
  \ifx#1.\stepcounter{@wire@end}\else%
  \fi\fi%
  \wires@line@loop%
}
\newcommand\wires@push{\@ifnextchar>\wires@push@two\wires@push@one}
\newcommand\wires@pop {\@ifnextchar<\wires@pop@two{\@ifnextchar+\wires@popsend\wires@pop@one}}
\newcommand\wires@send{\@ifnextchar+\wires@send@two{\@ifnextchar<\wires@sendpop\wires@send@one}}
\newcommand\wires@push@one{
	\foreach \y in {\yup,\ydn} {
	    \node[push,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@start}
\newcommand\wires@pop@one {
	\foreach \y in {\yup,\ydn} {
	    \node[pop1,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \foreach \y in {\yup,\ydn} {
	    \node[pop2,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@start}
\newcommand\wires@send@one{
	\foreach \y in {\yup,\ydn} {
	    \node[send,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@start}
\newcommand\wires@push@two{
	\foreach \y in {\yup,\ydn} {
	  \foreach \x in {2pt,-2pt}  {
	    \node[push,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }}
    \wires@gobble}
\newcommand\wires@pop@two {
	\foreach \y in {\yup,\ydn} {
	  \foreach \x in {2pt,-2pt}  {
	    \node[pop1,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }}
    \foreach \y in {\yup,\ydn} {
	  \foreach \x in {2pt,-2pt}  {
	    \node[pop2,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }}
	\wires@gobble}
\newcommand\wires@send@two{
	\foreach \y in {\yup,\ydn} {
	  \foreach \x in {2pt,-2pt}  {
	    \node[send,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }}
    \wires@gobble}
\newcommand\wires@sendpop{
	\foreach \y in {\yup,\ydn} {
	    \node[send,xshift=-2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
	\foreach \y in {\yup,\ydn} {
	    \node[pop1,xshift= 2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
	\foreach \y in {\yup,\ydn} {
	    \node[pop2,xshift= 2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@gobble}
\newcommand\wires@popsend{
	\foreach \y in {\yup,\ydn} {
	    \node[send,xshift= 2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
	\foreach \y in {\yup,\ydn} {
	    \node[pop1,xshift=-2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
	\foreach \y in {\yup,\ydn} {
	    \node[pop2,xshift=-2pt,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@gobble}
\newcommand\wires@popsendx{
	\foreach \y/\x/\i in {\yup/2pt/send,\ydn/-2pt/send,\ydn/2pt/pop1,\yup/-2pt/pop1} {
	    \node[\i,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@gobble}
\newcommand\wires@sendpopx{
	\foreach \y/\x/\i in {\yup/-2pt/send,\ydn/2pt/send,\ydn/-2pt/pop1,\yup/2pt/pop1} {
	    \node[\i,xshift=\x,yshift=\y] at (\the@wire,\the@wire@y) {}; }
    \wires@gobble}
\newcommand\wires@sup[1]{\node[yshift=  8pt,yshift=\yup,anchor=base] at (\the@wire,\the@wire@y) {$\wire@label{#1}$};\wires@start}
\newcommand\wires@sub[1]{\node[yshift=-13pt,yshift=\ydn,anchor=base] at (\the@wire,\the@wire@y) {$\wire@label{#1}$};\wires@start}

\newcommand\termbox[5][term]{
	\colorlet{thiscolor}{#1}
	\coordinate[xshift= 2pt,yshift= 2pt] (bottomleft)  at (#2,#4);
	\coordinate[xshift= 2pt,yshift=-2pt] (topleft)     at (#2,#5);
	\coordinate[xshift=-2pt,yshift= 2pt] (bottomright) at (#3,#4);
	\coordinate[xshift=-2pt,yshift=-2pt] (topright)    at (#3,#5);
	\draw[thiscolor,fill=thiscolor!05,rounded corners] (bottomleft) rectangle (topright);
	\termbox@label
}
\newcommand\termbox@label{\@ifnextchar^\termbox@label@up{\@ifnextchar_\termbox@label@down\relax}}
\newcommand\termbox@label@up  [2]{\path (topleft)    --node[inner sep=0pt,outer sep=2pt,anchor=south,thiscolor]{$\trm{#2}$} (topright);}
\newcommand\termbox@label@down[2]{\path (bottomleft) --node[inner sep=0pt,outer sep=2pt,anchor=north,thiscolor]{$\trm{#2}$} (bottomright);}












