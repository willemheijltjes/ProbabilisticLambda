\newcommand\Rvecup[1]{%
\tikz[baseline=(n.base)]{\node[inner sep=0pt,outer sep=0pt](n){$#1\vphantom($};\draw[arrows={->[harpoon]}](n.north west)--(n.north east);}%
}
\newcommand\Lvecup[1]{%
